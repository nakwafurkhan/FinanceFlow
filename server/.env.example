# ============================================
# FinanceFlow Server Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Server port — keep 5000 unless something is already using it
PORT=5000

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/financeflow?retryWrites=true&w=majority

# JWT secret — generate any long random string, e.g. with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=30d

# Origin allowed by CORS (your Vite frontend URL during local dev)
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
